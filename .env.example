# Server-side AutoCount integration credentials. Set these in the server
# environment — they are secrets and must never reach the browser, HTML, or
# API responses.

# AutoCount Cloud Accounting Integration API credentials.
AUTOCOUNT_API_KEY_ID=
AUTOCOUNT_API_KEY=

# AutoCount account book IDs. Each company key maps to exactly one account
# book; the two must be distinct. The client never supplies these — the
# server resolves them from a CompanyKey only.
AUTOCOUNT_ACCOUNT_BOOK_WANSON_ENTERPRISE=
AUTOCOUNT_ACCOUNT_BOOK_WANSON_SDN_BHD=

# Optional: SQLite idempotency/audit database path. Defaults to
# data/invoice_requests.db relative to the working directory.
INVOICE_REQUESTS_DB=

# Verified AutoCount Cloud invoice report URL template. HTTPS, with exactly
# one {doc_key} placeholder. The account-book path stays in this value on the
# server — never in the browser or the OpenAPI schema.
AUTOCOUNT_CLOUD_INVOICE_URL_TEMPLATE=
